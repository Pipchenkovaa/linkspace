[Unit]
Description=LinkSpace API (FastAPI + uvicorn)
After=network.target

[Service]
User=YOUR_USER
WorkingDirectory=/home/YOUR_USER/linkspace
EnvironmentFile=/home/YOUR_USER/linkspace/.env
StateDirectory=linkspace
ExecStart=/home/YOUR_USER/linkspace/.venv/bin/uvicorn app_final:app --host 127.0.0.1 --port 8000 --root-path /api
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
