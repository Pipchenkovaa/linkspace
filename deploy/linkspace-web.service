[Unit]
Description=LinkSpace web (Next.js)
After=network.target linkspace-api.service

[Service]
User=YOUR_USER
WorkingDirectory=/home/YOUR_USER/linkspace/frontend
Environment=NODE_ENV=production
ExecStart=/usr/bin/node node_modules/next/dist/bin/next start --hostname 127.0.0.1 --port 3000
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
